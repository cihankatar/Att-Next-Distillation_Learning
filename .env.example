# Dataset root. It must contain one directory per dataset.
ML_DATA_ROOT=/absolute/path/to/datasets

# Checkpoint/output locations. They may point to the same directory.
ML_DATA_OUTPUT=/absolute/path/to/outputs
ML_DATA_OUTPUT_LOCAL=/absolute/path/to/outputs

# Runtime selection used by the training and test entry points.
TOPODISTILL_DATASET=isic_2018_1
TOPODISTILL_TEST_DATASET=PH2Dataset
TOPODISTILL_SEED=932

# Optional explicit encoder checkpoint for downstream fine-tuning.
# TOPODISTILL_ENCODER_CHECKPOINT=/absolute/path/to/encoder_checkpoint.pth
# TOPODISTILL_MODEL_CHECKPOINT=/absolute/path/to/segmentation_checkpoint.pth

# Weights & Biases. Keep offline for a local smoke run; switch to online as needed.
WANDB_MODE=offline
WANDB_DIR=/absolute/path/to/wandb
# WANDB_API_KEY=
